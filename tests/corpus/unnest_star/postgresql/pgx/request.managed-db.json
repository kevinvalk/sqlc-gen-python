  "queries": [
    {
      "text": "SELECT p.plan_id, p.item_id\nFROM (SELECT unnest FROM unnest($1::bigint[])) AS i(req_item_id),\nLATERAL (\n    SELECT plan_id, item_id\n    FROM plan_items\n    WHERE\n        item_id = i.req_item_id AND\n        ($2 = 0 OR plan_id < $2)\n    ORDER BY plan_id DESC\n    LIMIT $3\n) p",
      "name": "GetPlanItems",
      "cmd": ":many",
