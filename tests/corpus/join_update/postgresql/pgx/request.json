  "queries": [
    {
      "text": "UPDATE group_calc_totals gct \nSET npn = nem.npn \nFROM producer_group_attribute ga \nJOIN npn_external_map nem ON ga.npn_external_map_id = nem.id \nWHERE gct.group_id = ga.group_id",
