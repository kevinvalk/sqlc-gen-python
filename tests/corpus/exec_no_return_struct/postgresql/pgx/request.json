  "queries": [
    {
      "text": "UPDATE job\nSET last_run = NOW()\nFROM (\n        SELECT last_run,\n            task_name\n        FROM job AS o\n        WHERE o.task_name = $1 \n  \t\tFOR UPDATE\n    ) AS old_values\nWHERE job.task_name = $1\nRETURNING job.last_run AS this_run,\n    old_values.last_run AS last_run",
