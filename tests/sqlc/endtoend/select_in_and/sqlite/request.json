  "queries": [
    {
      "text": "DELETE FROM\n  books AS b\nWHERE\n  b.author NOT IN (\n    SELECT\n      a.name\n    FROM\n      authors a\n    WHERE\n      a.age >= ?\n  )\n  AND b.translator NOT IN (\n    SELECT\n      t.name\n    FROM\n      translators t\n    WHERE\n      t.age >= ?\n  )\n  AND b.year <= ?",
      "name": "DeleteAuthor",
      "cmd": ":exec",
