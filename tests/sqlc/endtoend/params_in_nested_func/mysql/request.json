    {
      "text": "SELECT\n    rg.groupId,\n    rg.groupName\nFROM \n    RouterGroup rg\nWHERE\n    rg.groupName LIKE CONCAT('%', COALESCE(?, rg.groupName), '%') AND\n    rg.groupId = COALESCE(?, rg.groupId)",
