{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":preserveSemverRanges", // A range stays a range, replaced only by a version outside it
    ":automergeAll", // Majors too: CI, the whole proof, decides
    ":automergeBranch", // As commits on main, without a pull request
  ],
  // IMPORTANT: This needs to match GitHub Actions schedule which run in UTC (renovate without timezone also runs UTC)
  automergeSchedule: ["* 0-6 * * *"],
  // A week before a release is proposed, so a compromised one can be caught and yanked first.
  minimumReleaseAge: "7 days",
  // Every update waits for CI on its branch (ci.yml runs on `renovate/**`): a new driver, ruff, sqlc or database can
  // change what is generated or proven. One that fails becomes a pull request, to finish by hand: for sqlc,
  // `cargo xtask capture`; for a database, `cargo xtask verify` (docs/development.md).
  enabledManagers: ["cargo", "pep621", "github-actions", "proto", "custom.regex"],
  packageRules: [
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
    },
    {
      // The plugin and xtask share the root Cargo.lock. Cargo.toml names the release each crate was last proven
      // at, a caret range every later one is inside: bumped, or Cargo.lock would never move.
      groupName: "cargo",
      matchManagers: ["cargo"],
      rangeStrategy: "bump",
    },
    {
      // The Python side of the proof (tests/python), with its uv.lock.
      groupName: "python",
      matchManagers: ["pep621"],
    },
    {
      // The plugin formats with ruff's crates, and the gate checks with ruff itself: one version, moved together
      // (tests/rust/golden.rs fails otherwise). Always a pull request: Renovate moves the crates' tag in Cargo.toml
      // but not Cargo.lock, which `cargo update` then does by hand.
      groupName: "ruff",
      matchPackageNames: ["ruff", "astral-sh/ruff"],
    },
    {
      // pglast 7 is PostgreSQL 17's scanner, the one the pinned sqlc parses with: its major moves with sqlc's, by
      // hand.
      matchPackageNames: ["pglast"],
      allowedVersions: "<8",
    },
    {
      // MySQL's long-term release. A 9.x is an innovation release, supported only until the next.
      matchDatasources: ["docker"],
      matchPackageNames: ["mysql"],
      allowedVersions: "/^8\\./",
    },
  ],
  customManagers: [
    {
      // The Rust toolchain, an exact release (rust-toolchain.toml says why).
      customType: "regex",
      managerFilePatterns: ["/^rust-toolchain\\.toml$/"],
      matchStrings: ["channel = \"(?<currentValue>[0-9.]+)\""],
      depNameTemplate: "rust-lang/rust",
      datasourceTemplate: "github-releases",
    },
    {
      // ruff's crates, a git tag the cargo manager leaves alone.
      customType: "regex",
      managerFilePatterns: ["/^Cargo\\.toml$/"],
      matchStrings: ["git = \"https://github\\.com/astral-sh/ruff\\.git\", tag = \"(?<currentValue>[0-9.]+)\""],
      depNameTemplate: "astral-sh/ruff",
      datasourceTemplate: "github-releases",
    },
    {
      // The uv CI runs. A new minor is outside the range tests/python/pyproject.toml requires, which then fails:
      // widened by hand, with uv's changelog read.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: ["UV_VERSION: \"(?<currentValue>[0-9.]+)\""],
      depNameTemplate: "astral-sh/uv",
      datasourceTemplate: "github-releases",
    },
    {
      // sqlc, a plugin's tool, which the proto manager skips. CI fails on a new one until `cargo xtask capture`
      // has captured what it sends.
      customType: "regex",
      managerFilePatterns: ["/^\\.prototools$/"],
      matchStrings: ["sqlc = \"(?<currentValue>[0-9.]+)\""],
      depNameTemplate: "sqlc-dev/sqlc",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      // The databases the proof runs on: `NEWEST = "postgres:18"`, `IMAGE = "mysql:8.4"`. Not capture.py's
      // POSTGRES, which is the version sqlc's own tests run and moves with sqlc.
      customType: "regex",
      managerFilePatterns: ["/^tests/python/(postgres|mysql)\\.py$/"],
      matchStrings: ["= \"(?<depName>postgres|mysql):(?<currentValue>[0-9.]+)\""],
      datasourceTemplate: "docker",
    },
  ],
}
